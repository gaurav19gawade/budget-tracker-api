# Railway/production environment variables. Never commit real values.
# (Local development needs none of these: use the "local" profile, see README.)
DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
DB_POOL_SIZE=5
DB_SCHEMA=budget

# Comma-separated list of frontend origins allowed to call this API (the Vercel URL)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Phase 1: Supabase JWT validation
SUPABASE_JWKS_URI=
SUPABASE_ISSUER=

# Phase 2: Teller (development/production need the mTLS client cert)
TELLER_ENV=sandbox
TELLER_APPLICATION_ID=
TELLER_CERT_PEM_BASE64=
TELLER_KEY_PEM_BASE64=

# Phase 2: AES-GCM key (base64, 32 bytes) for encrypting Teller access tokens at rest
TOKEN_ENCRYPTION_KEY=
